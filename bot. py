def handle_admin_card_choice(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if not is_admin(user_id):
        return
    try:
        choice = int(message.text.strip())
        if choice not in [1,2,3,4]:
            raise ValueError
    except:
        bot.send_message(chat_id, "❌ Введите число от 1 до 4.", parse_mode="HTML")
        return
    mapping = {
        1: ('CARD_NUMBER', 'номер карты'),
        2: ('BANK_NAME', 'название банка'),
        3: ('RECIPIENT_NAME', 'ФИО получателя'),
        4: ('PHONE_NUMBER', 'номер телефона')
    }
    key, desc = mapping[choice]
    msg = bot.send_message(
        chat_id,
        f"💳 Изменение <b>{desc}</b>\n\nТекущее значение: <b>{db.get_setting(key) or 'Не указано'}</b>\n\nВведите новое значение:",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )
    bot.register_next_step_handler(msg, handle_admin_card_value, key, desc)

def handle_admin_card_value(message, key, desc):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if not is_admin(user_id):
        return
    new_val = message.text.strip()
    if not new_val:
        bot.send_message(chat_id, "❌ Значение не может быть пустым.", parse_mode="HTML")
        return
    db.set_setting(key, new_val)
    sync_config_from_db()
    bot.send_message(chat_id, f"✅ <b>{desc}</b> успешно изменён на <b>{new_val}</b>", parse_mode="HTML")
    show_main_menu(chat_id)

