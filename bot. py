# ----- АДМИН: ИЗМЕНЕНИЕ НАСТРОЕК -----
def handle_admin_settings_choice(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if not is_admin(user_id):
        return
    try:
        choice = int(message.text.strip())
    except:
        bot.send_message(chat_id, "❌ Введите число от 1 до 12.", parse_mode="HTML")
        return
    settings_map = {
        1: ('PRICE_PER_GMP_RUB', 'Цена 1 GMP (₽)', 'число', float),
        2: ('CRYPTO_RATE', 'Курс крипты (GMP за 1 USD)', 'число', float),
        3: ('MIN_RUB_AMOUNT', 'Мин. сумма пополнения (₽)', 'число', float),
        4: ('MAX_RUB_AMOUNT', 'Макс. сумма пополнения (₽)', 'число', float),
        5: ('MIN_CRYPTO_AMOUNT', 'Мин. сумма пополнения (USD)', 'число', float),
        6: ('MAX_CRYPTO_AMOUNT', 'Макс. сумма пополнения (USD)', 'число', float),
        7: ('MIN_WITHDRAW_GMP', 'Мин. сумма вывода (GMP)', 'число', float),
        8: ('MIN_REFERRALS_FOR_WITHDRAW', 'Кол-во рефералов для вывода', 'целое число', int),
        9: ('REFERRAL_PERCENT', '% реферальных начислений', 'число', float),
        10: ('CASE_COOLDOWN_MINUTES', 'Время кулдауна кейса (мин)', 'число', float),
        11: ('MIN_CASE_REWARD', 'Мин. награда кейса (GMP)', 'число', float),
        12: ('MAX_CASE_REWARD', 'Макс. награда кейса (GMP)', 'число', float)
    }
    if choice not in settings_map:
        bot.send_message(chat_id, "❌ Неверный номер. Введите от 1 до 12.", parse_mode="HTML")
        return
    key, desc, type_desc, conv = settings_map[choice]
    current = db.get_setting(key)
    msg = bot.send_message(
        chat_id,
        f"💱 <b>Изменение: {desc}</b>\n\n"
        f"Текущее значение: <b>{current}</b>\n"
        f"Введите новое значение ({type_desc}):",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )
    bot.register_next_step_handler(msg, handle_admin_settings_value, key, conv, desc)

def handle_admin_settings_value(message, key, conv, desc):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if not is_admin(user_id):
        return
    try:
        new_val = conv(message.text.strip())
        if new_val < 0:
            raise ValueError
    except:
        bot.send_message(chat_id, f"❌ Некорректное значение. Введите положительное {desc}.", parse_mode="HTML")
        return
    db.set_setting(key, new_val)
    bot.send_message(chat_id, f"✅ <b>{desc}</b> успешно изменено на <b>{new_val}</b>", parse_mode="HTML")
    show_main_menu(chat_id)

