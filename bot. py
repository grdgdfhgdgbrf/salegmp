# ====== РАССЫЛКА ======
def handle_broadcast(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    
    if is_bot_itself(user_id):
        return
    
    if not is_admin(user_id):
        return
    
    text = message.text
    
    conn = sqlite3.connect(Config.DB_PATH)
    cur = conn.cursor()
    cur.execute('SELECT user_id FROM users')
    users = cur.fetchall()
    conn.close()
    
    sent = 0
    failed = 0
    
    status_msg = bot.send_message(chat_id, "📢 <b>Начинаю рассылку...</b>", parse_mode="HTML")
    
    for user in users:
        try:
            if not is_bot_itself(user[0]):
                bot.send_message(user[0], text, parse_mode="HTML")
                sent += 1
                if sent % 10 == 0:
                    try:
                        bot.edit_message_text(
                            f"📢 <b>Рассылка в процессе...</b>\n\n"
                            f"✅ Отправлено: <b>{sent}</b>\n"
                            f"❌ Ошибок: <b>{failed}</b>",
                            chat_id,
                            status_msg.message_id,
                            parse_mode="HTML"
                        )
                    except:
                        pass
        except Exception as e:
            failed += 1
            logger.error(f"Ошибка рассылки {user[0]}: {e}")
    
    bot.edit_message_text(
        f"📢 <b>Рассылка завершена!</b>\n\n"
        f"✅ Отправлено: <b>{sent}</b>\n"
        f"❌ Ошибок: <b>{failed}</b>",
        chat_id,
        status_msg.message_id,
        parse_mode="HTML"
    )

# ====== АДМИН: ЗАБАНИТЬ ======
def handle_ban_user(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    admin_id = user_id
    
    if not is_admin(admin_id):
        return
    
    target = message.text.strip()
    
    # Пытаемся найти пользователя по ID или username
    try:
        if target.startswith('@'):
            # По username
            target_user = bot.get_chat(target)
            target_id = target_user.id
        else:
            # По ID
            target_id = int(target)
    except:
        bot.send_message(
            chat_id,
            "❌ Пользователь не найден!\n"
            "Проверьте ID или @username и попробуйте снова.",
            parse_mode="HTML"
        )
        return
    
    if target_id == admin_id:
        bot.send_message(chat_id, "❌ Нельзя забанить самого себя!", parse_mode="HTML")
        return
    
    if is_admin(target_id):
        bot.send_message(chat_id, "❌ Нельзя забанить администратора!", parse_mode="HTML")
        return
    
    # Запрашиваем причину
    msg = bot.send_message(
        chat_id,
        f"🚫 <b>Бан пользователя</b>\n\n"
        f"👤 ID: <code>{target_id}</code>\n\n"
        f"✏️ Введите причину бана:\n"
        "(или отправьте 'пропустить' для стандартной причины)",
        parse_mode="HTML"
    )
    bot.register_next_step_handler(msg, handle_ban_reason, target_id)

def handle_ban_reason(message, target_id):
    user_id = message.from_user.id
    chat_id = message.chat.id
    
    if not is_admin(user_id):
        return
    
    reason = message.text.strip()
    if reason.lower() == 'пропустить':
        reason = "Нарушение правил"
    
    db.ban_user(target_id, reason, user_id)
    
    try:
        bot.send_message(
            target_id,
            f"🚫 <b>Вы заблокированы в боте!</b>\n\n"
            f"📌 Причина: {reason}\n\n"
            "Если вы считаете, что это ошибка, обратитесь к администратору.",
            parse_mode="HTML"
        )
    except:
        pass
    
    bot.send_message(
        chat_id,
        f"✅ <b>Пользователь забанен!</b>\n\n"
        f"👤 ID: <code>{target_id}</code>\n"
        f"📌 Причина: {reason}",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

# ====== АДМИН: РАЗБАНИТЬ ======
def handle_unban_user(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    
    if not is_admin(user_id):
        return
    
    try:
        target_id = int(message.text.strip())
    except:
        bot.send_message(
            chat_id,
            "❌ Введите корректный ID пользователя!\n"
            "Пример: 123456789",
            parse_mode="HTML"
        )
        return
    
    if not db.is_user_banned(target_id):
        bot.send_message(
            chat_id,
            f"❌ Пользователь <code>{target_id}</code> не забанен!",
            parse_mode="HTML"
        )
        return
    
    db.unban_user(target_id)
    
    try:
        bot.send_message(
            target_id,
            "🔓 <b>Вы разблокированы в боте!</b>\n\n"
            "Теперь вы снова можете пользоваться ботом.",
            parse_mode="HTML"
        )
    except:
        pass
    
    bot.send_message(
        chat_id,
        f"✅ <b>Пользователь разбанен!</b>\n\n"
        f"👤 ID: <code>{target_id}</code>",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

