        f"💳 <b>Пополнение по карте</b>\n{divider()}\n"
        f"👤 {username}\n"
        f"💎 {gmp_amount:.2f} GMP\n"
        f"💳 {order['amount']:.2f} ₽\n{divider()}\n"
        f"<code>пополнение {gmp_amount:.2f} GMP @{user['username'] if user and user['username'] else ''}</code>"
    )
    if Config.ADMIN_ID:
        try:
            admin_msg = bot.send_photo(
                Config.ADMIN_ID,
                message.photo[-1].file_id,
