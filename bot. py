def format_date(date_str):
    if not date_str:
        return "Неизвестно"
    try:
        dt = datetime.strptime(date_str, '%Y-%m-%d %H:%M:%S')
        return dt.strftime('%d.%m.%Y %H:%M')
    except ValueError:
        try:
            dt = datetime.strptime(date_str, '%Y-%m-%d %H:%M:%S.%f')
            return dt.strftime('%d.%m.%Y %H:%M')
        except ValueError:
            return date_str[:16] if len(date_str) > 16 else date_str

