    if db.is_user_banned(user_id):
        bot.send_message(message.chat.id, "🚫 Вы заблокированы в боте!")
        return
    if len(message.text.split()) > 1:
        referral_code = message.text.split()[1]
        referrer_id = db.get_user_by_referral_code(referral_code)
        if referrer_id and referrer_id != user_id:
            user = db.get_user(user_id)
            if not user or not user['registered']:
                try:
                    chat = bot.get_chat(user_id)
                    username = chat.username
                    first_name = chat.first_name or "Пользователь"
                    last_name = chat.last_name
                except:
                    username = None
                    first_name = "Пользователь"
                    last_name = None
                db.register_user(user_id, username, first_name, last_name, referrer_id)
                db.add_referral(referrer_id, user_id)
                try:
                    bot.send_message(referrer_id, f"Пользователь @{username or first_name} перешел по вашей ссылке!")
                except:
                    pass
                bot.send_message(
                    message.chat.id,
                    "✅ Вы зарегистрированы по реферальной ссылке!\nТеперь вы можете пользоваться ботом.",
                    parse_mode="HTML"
                )
                show_main_menu(message.chat.id)
                return
    show_main_menu(message.chat.id)
    try:
        bot.set_my_commands([BotCommand("start", "💸 Купить GMP")])
    except Exception as e:
        logger.error(f"Ошибка установки команд: {e}")

