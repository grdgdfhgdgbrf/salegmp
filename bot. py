def format_date(date_str):
    if not date_str:
        return "Неизвестно"
    try:
        dt = datetime.strptime(date_str, '%Y-%m-%d %H:%M:%S')
        return dt.strftime('%d.%m.%Y %H:%M')
    except ValueError:
        try:
            dt = datetime.strptime(date_str, '%Y-%m-%d %H:%M:%S.%f')
            return dt.strftime('%d.%m.%Y %H:%M')
        except ValueError:
            return date_str[:16] if len(date_str) > 16 else date_str

def safe_edit_or_send(chat_id, message_id, text, reply_markup=None, parse_mode=None):
    try:
        bot.edit_message_text(text, chat_id, message_id, parse_mode=parse_mode, reply_markup=reply_markup)
        return True
    except Exception as e:
        logger.error(f"Ошибка редактирования: {e}")
        try:
            bot.send_message(chat_id, text, parse_mode=parse_mode, reply_markup=reply_markup)
            return True
        except Exception as e2:
            logger.error(f"Ошибка отправки: {e2}")
            return False

def safe_delete_message(chat_id, message_id):
    try:
        if message_id:
            bot.delete_message(chat_id, message_id)
        return True
    except Exception as e:
        logger.error(f"Ошибка удаления сообщения {message_id}: {e}")
        return False

