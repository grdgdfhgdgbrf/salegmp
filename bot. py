    def withdraw_bonus(self, user_id, amount):
        """Списание с бонусного баланса"""
        conn = sqlite3.connect(self.db_path)
        cur = conn.cursor()
        cur.execute('''
            UPDATE bonus_balance 
            SET balance = balance - ? 
            WHERE user_id = ? AND balance >= ?
        ''', (amount, user_id, amount))
        updated = cur.rowcount
        
        if updated > 0:
            cur.execute('''
                INSERT INTO bonus_history (user_id, amount, type, description)
                VALUES (?, ?, ?, ?)
            ''', (user_id, -amount, 'withdraw', 'Вывод средств'))
            
            cur.execute('''
                UPDATE users SET total_withdrawn = total_withdrawn + ? 
                WHERE user_id = ?
            ''', (amount, user_id))
        
        conn.commit()
        conn.close()
        return updated > 0

