                username TEXT,
                first_name TEXT,
                last_name TEXT,
                registered INTEGER DEFAULT 0,
                balance REAL DEFAULT 0,
                total_spent REAL DEFAULT 0,
                orders_count INTEGER DEFAULT 0,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
