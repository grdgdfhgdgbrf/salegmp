                    bot.send_message(
                        referrer_id,
                        f"🎉 Ваш реферал совершил покупку на {order['gmp_amount']:.0f} GMP!\n"
                        f"💰 Вы получили {bonus:.2f} GMP ({referral_percent}%)",
                        parse_mode="HTML"
                    )
                except:
                    pass
        
        # Удаляем сообщение админа с заявкой, если есть
        admin_msg_id = order['admin_message_id'] if order['admin_message_id'] else None
        if admin_msg_id:
            safe_delete_message(Config.ADMIN_ID, admin_msg_id)
        user_msg_id = order['user_message_id'] if order['user_message_id'] else None
        if user_msg_id:
            safe_delete_message(user_id_order, user_msg_id)
        
        # Уведомляем пользователя
