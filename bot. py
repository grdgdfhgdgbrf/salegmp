            db.update_order_status(order_id, status='pending', admin_msg_id=admin_msg.message_id)
        except Exception as e:
            logger.error(f"Ошибка отправки админу: {e}")
    bot.send_message(
        chat_id,
        "✅ <b>Скриншот отправлен!</b>\n\n⏳ Ожидайте подтверждения администратора.\nОбычно это занимает 5-15 минут.",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

