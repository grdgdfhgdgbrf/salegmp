# ====== ВЫВОД GMP - ВВОД СУММЫ ======
def handle_withdraw_amount(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    
    if is_bot_itself(user_id):
        return
    
    try:
        amount = float(message.text.replace(',', '.'))
        
        if amount < Config.MIN_WITHDRAW_GMP:
            bot.send_message(
                chat_id,
                f"❌ Минимальная сумма для вывода: <b>{Config.MIN_WITHDRAW_GMP} GMP</b>\n\n"
                f"✏️ Введите корректную сумму",
                parse_mode="HTML",
                reply_markup=withdraw_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_withdraw_amount)
            return
        
        bonus_balance = db.get_bonus_balance(user_id)
        
        if amount > bonus_balance:
            bot.send_message(
                chat_id,
                f"❌ Недостаточно средств!\n\n"
                f"🎁 Ваш бонусный баланс: <b>{int(bonus_balance)} GMP</b>\n"
                f"✏️ Введите сумму меньше или равную балансу",
                parse_mode="HTML",
                reply_markup=withdraw_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_withdraw_amount)
            return
        
        bot.send_message(
            chat_id,
            f"💰 Сумма: <b>{int(amount)} GMP</b>\n\n"
            f"📱 <b>Введите ID или @username получателя:</b>\n"
            "(Telegram ID или юзернейм, куда отправить GMP)",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_recipient, amount)
        
    except ValueError:
        bot.send_message(
            chat_id,
            "❌ Введите <b>число</b> (только цифры)\n\n"
            "✏️ Например: 50",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_amount)

