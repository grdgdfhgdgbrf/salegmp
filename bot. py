# ----- ВЫВОД GMP -----
def handle_withdraw_amount(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id):
        return
    try:
        amount = float(message.text.replace(',', '.'))
        min_withdraw = Config.MIN_WITHDRAW_GMP
        if amount < min_withdraw:
            bot.send_message(
                chat_id,
                f"❌ Минимальная сумма для вывода: <b>{min_withdraw:.2f} GMP</b>\n\n✏️ Введите корректную сумму",
                parse_mode="HTML",
                reply_markup=withdraw_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_withdraw_amount)
            return
        bonus_balance = db.get_bonus_balance(user_id)
        if amount > bonus_balance:
            bot.send_message(
                chat_id,
                f"❌ Недостаточно средств!\n\n🎁 Ваш бонусный баланс: <b>{bonus_balance:.2f} GMP</b>\n✏️ Введите сумму меньше или равную балансу",
                parse_mode="HTML",
                reply_markup=withdraw_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_withdraw_amount)
            return
        bot.send_message(
            chat_id,
            f"💰 Сумма: <b>{amount:.2f} GMP</b>\n\n📱 <b>Введите ID или @username получателя:</b>\n"
            "(Telegram ID или юзернейм, куда отправить GMP)",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_recipient, amount)
    except ValueError:
        bot.send_message(
            chat_id,
            "❌ Введите <b>число</b> (можно дробное)\n\n✏️ Например: 50.5",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_amount)

def handle_withdraw_recipient(message, amount):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id):
        return
    recipient = message.text.strip()
    if len(recipient) < 2:
        bot.send_message(
            chat_id,
            "❌ Некорректный получатель!\n\n📱 Введите ID или @username получателя",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_recipient, amount)
        return
    request_id = db.create_withdraw_request(user_id, amount, recipient)
    user = db.get_user(user_id)
    username = f"@{user['username']}" if user and user['username'] else f"ID: {user_id}"
    if Config.ADMIN_ID:
        try:
            caption = (
                f"💸 <b>Заявка на вывод GMP</b>\n{divider()}\n"
                f"👤 От: {username}\n"
                f"💰 Сумма: <b>{amount:.2f} GMP</b>\n"
                f"📱 Получатель: <b>{recipient}</b>\n"
                f"📅 {datetime.now().strftime('%d.%m.%Y %H:%M')}\n{divider()}\n"
                f"<code>перевод {amount:.2f} GMP на {recipient}</code>"
            )
            admin_msg = bot.send_message(
                Config.ADMIN_ID,
                caption,
                parse_mode="HTML",
                reply_markup=admin_withdraw_keyboard(request_id)
            )
            db.update_withdraw_status(request_id, "pending", admin_msg_id=admin_msg.message_id)
        except Exception as e:
            logger.error(f"Ошибка отправки админу: {e}")
    bot.send_message(
        chat_id,
        f"✅ <b>Заявка на вывод принята!</b>\n\n⏳ Ожидайте обработки администратором.\n"
        "Обычно это занимает до 24 часов.\n\n📌 Если у вас возникли вопросы, обратитесь в поддержку.",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

# ----- РУБЛИ -----
def handle_rubles_amount(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id):
        return
    try:
        amount = float(message.text.replace(',', '.'))
        min_rub = Config.MIN_RUB_AMOUNT
        max_rub = Config.MAX_RUB_AMOUNT
        if amount < min_rub:
            bot.send_message(
                chat_id,
                f"❌ Минимальная сумма: <b>{min_rub:.2f} ₽</b>\n\n✏️ Введите корректную сумму",
                parse_mode="HTML",
                reply_markup=rubles_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_rubles_amount)
            return
        if amount > max_rub:
            bot.send_message(
                chat_id,
                f"❌ Максимальная сумма: <b>{max_rub:.2f} ₽</b>\n\n✏️ Введите корректную сумму",
                parse_mode="HTML",
                reply_markup=rubles_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_rubles_amount)
            return
        price = Config.PRICE_PER_GMP_RUB
        gmp = amount / price
        # Проверяем доступное количество GMP
        if gmp > Config.TOTAL_GMP_AVAILABLE:
            bot.send_message(
                chat_id,
                f"❌ Недостаточно GMP на складе! Доступно: <b>{Config.TOTAL_GMP_AVAILABLE:.0f}</b>\n"
                "Пожалуйста, уменьшите сумму заказа.",
                parse_mode="HTML",
                reply_markup=rubles_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_rubles_amount)
            return
        order_id = db.create_order(user_id, "rubles", amount, gmp)
        # Получаем актуальные реквизиты карты из БД или Config
        card_num = db.get_setting('CARD_NUMBER') or Config.CARD_NUMBER
        bank = db.get_setting('BANK_NAME') or Config.BANK_NAME
        recipient = db.get_setting('RECIPIENT_NAME') or Config.RECIPIENT_NAME
        phone = db.get_setting('PHONE_NUMBER') or Config.PHONE_NUMBER
        text = (
            f"💳 <b>{amount:.2f} ₽ → {gmp:.0f} GMP</b>\n\n"
            "🧾 <b>РЕКВИЗИТЫ ДЛЯ ОПЛАТЫ</b>\n"
            f"💳 Номер карты: <code>{card_num}</code>\n"
            f"🏦 Банк: {bank}\n"
            f"👤 Получатель: {recipient}\n"
            f"📱 Телефон: <code>{phone}</code>\n\n"
            "⚠️ <b>Внимание!</b>\n"
            "▫️ При переводе с другого банка могут быть комиссии\n"
            "▫️ Указывайте точную сумму в назначении платежа\n\n"
            "✅ После оплаты нажмите кнопку ниже"
        )
        msg = bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=confirm_rubles_keyboard(order_id))
        db.update_order_status(order_id, status='pending', user_msg_id=msg.message_id)
    except ValueError:
        bot.send_message(
            chat_id,
            "❌ Введите <b>число</b> (можно дробное)\n\n✏️ Например: 100.50",
            parse_mode="HTML",
            reply_markup=rubles_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_rubles_amount)

def handle_rubles_screenshot(message, order_id):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id):
        return
    if not message.photo:
        bot.send_message(
            chat_id,
            "❌ Пожалуйста, отправьте <b>фото</b> скриншота оплаты\n\n📤 Отправьте изображение",
            parse_mode="HTML",
            reply_markup=cancel_keyboard()
        )
        bot.register_next_step_handler(message, handle_rubles_screenshot, order_id)
        return
    order = db.get_order(order_id)
    if not order:
        bot.send_message(chat_id, "❌ Заявка не найдена")
        return
    # Сохраняем file_id скриншота в заказе
    screenshot_file_id = message.photo[-1].file_id
    db.update_order_status(order_id, status='pending', screenshot_file_id=screenshot_file_id)
    
    user = db.get_user(user_id)
    username = f"@{user['username']}" if user and user['username'] else f"ID: {user_id}"
    gmp_amount = order['gmp_amount']
    gmp_floor = floor_gmp(gmp_amount)
    # Формируем caption для админа: "перевод {gmp_floor} @username" (без GMP)
    caption = (
        f"💳 <b>Перевод {gmp_floor} @{user['username'] if user and user['username'] else user_id}</b>\n"
        f"{divider()}\n"
        f"👤 {username}\n"
        f"💎 {gmp_floor} (перевод)\n"
        f"💳 {order['amount']:.2f} ₽\n"
        f"{divider()}\n"
        f"<code>перевод {gmp_floor} @{user['username'] if user and user['username'] else ''}</code>"
    )
    if Config.ADMIN_ID:
        try:
            admin_msg = bot.send_photo(
                Config.ADMIN_ID,
                screenshot_file_id,
                caption=caption,
                parse_mode="HTML",
                reply_markup=admin_confirm_keyboard(order_id)
            )
            db.update_order_status(order_id, status='pending', admin_msg_id=admin_msg.message_id)
        except Exception as e:
            logger.error(f"Ошибка отправки админу: {e}")
    bot.send_message(
        chat_id,
        "✅ <b>Скриншот отправлен!</b>\n\n⏳ Ожидайте подтверждения администратора.\nОбычно это занимает 5-15 минут.",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

# ----- РАССЫЛКА -----
def handle_broadcast(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id) or not is_admin(user_id):
        return
    text = message.text
    conn = sqlite3.connect(Config.DB_PATH)
    cur = conn.cursor()
    cur.execute('SELECT user_id FROM users')
    users = cur.fetchall()
    conn.close()
    sent = 0
    failed = 0
    status_msg = bot.send_message(chat_id, "📢 <b>Начинаю рассылку...</b>", parse_mode="HTML")
    for user in users:
        try:
            if not is_bot_itself(user[0]):
                bot.send_message(user[0], text, parse_mode="HTML")
                sent += 1
                if sent % 10 == 0:
                    try:
                        bot.edit_message_text(
                            f"📢 <b>Рассылка в процессе...</b>\n\n✅ Отправлено: <b>{sent}</b>\n❌ Ошибок: <b>{failed}</b>",
                            chat_id,
                            status_msg.message_id,
                            parse_mode="HTML"
                        )
                    except:
                        pass
        except Exception as e:
            failed += 1
            logger.error(f"Ошибка рассылки {user[0]}: {e}")
    bot.edit_message_text(
        f"📢 <b>Рассылка завершена!</b>\n\n✅ Отправлено: <b>{sent}</b>\n❌ Ошибок: <b>{failed}</b>",
        chat_id,
        status_msg.message_id,
        parse_mode="HTML"
    )

# ----- АДМИН: БАНЫ -----
def handle_ban_user(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    admin_id = user_id
    if not is_admin(admin_id):
        return
    target = message.text.strip()
    try:
        if target.startswith('@'):
            target_user = bot.get_chat(target)
            target_id = target_user.id
        else:
            target_id = int(target)
    except:
        bot.send_message(chat_id, "❌ Пользователь не найден!\nПроверьте ID или @username.", parse_mode="HTML")
        return
    if target_id == admin_id:
        bot.send_message(chat_id, "❌ Нельзя забанить самого себя!", parse_mode="HTML")
        return
    if is_admin(target_id):
        bot.send_message(chat_id, "❌ Нельзя забанить администратора!", parse_mode="HTML")
        return
    msg = bot.send_message(
        chat_id,
        f"🚫 <b>Бан пользователя</b>\n\n👤 ID: <code>{target_id}</code>\n\n✏️ Введите причину бана:\n(или отправьте 'пропустить')",
        parse_mode="HTML"
    )
    bot.register_next_step_handler(msg, handle_ban_reason, target_id)

def handle_ban_reason(message, target_id):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if not is_admin(user_id):
        return
    reason = message.text.strip()
    if reason.lower() == 'пропустить':
        reason = "Нарушение правил"
    db.ban_user(target_id, reason, user_id)
    try:
        bot.send_message(
            target_id,
            f"🚫 <b>Вы заблокированы в боте!</b>\n\n📌 Причина: {reason}\n\nЕсли считаете ошибкой, обратитесь к администратору.",
            parse_mode="HTML"
        )
    except:
        pass
    bot.send_message(
        chat_id,
        f"✅ <b>Пользователь забанен!</b>\n\n👤 ID: <code>{target_id}</code>\n📌 Причина: {reason}",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

def handle_unban_user(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if not is_admin(user_id):
        return
    try:
        target_id = int(message.text.strip())
    except:
        bot.send_message(chat_id, "❌ Введите корректный ID пользователя!\nПример: 123456789", parse_mode="HTML")
        return
    if not db.is_user_banned(target_id):
        bot.send_message(chat_id, f"❌ Пользователь <code>{target_id}</code> не забанен!", parse_mode="HTML")
        return
    db.unban_user(target_id)
    try:
        bot.send_message(target_id, "🔓 <b>Вы разблокированы в боте!</b>\n\nТеперь вы снова можете пользоваться ботом.", parse_mode="HTML")
    except:
        pass
    bot.send_message(
        chat_id,
        f"✅ <b>Пользователь разбанен!</b>\n\n👤 ID: <code>{target_id}</code>",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

