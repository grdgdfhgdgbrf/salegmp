# ====== ИЗМЕНЕНИЕ КУРСА RUB ======
def handle_change_rub_rate(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    
    if not is_admin(user_id):
        return
    
    try:
        new_rate = float(message.text.replace(',', '.'))
        if new_rate <= 0:
            raise ValueError
    except:
        bot.send_message(
            chat_id,
            "❌ Некорректное значение. Введите положительное число.\n"
            "Попробуйте снова или нажмите «Назад».",
            parse_mode="HTML",
            reply_markup=back_to_main_keyboard()
        )
        bot.register_next_step_handler(message, handle_change_rub_rate)
        return
    
    db.set_setting('RUB_TO_GMP', new_rate)
    bot.send_message(
        chat_id,
        f"✅ Курс RUB (цена 1 GMP) установлен: <b>{new_rate} ₽</b>\n\n"
        "Теперь введите новый курс <b>USD → GMP</b> (сколько GMP за 1 $):\n"
        "Текущий курс: " + str(db.get_setting_float('CRYPTO_TO_GMP')),
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )
    bot.register_next_step_handler(message, handle_change_crypto_rate)

