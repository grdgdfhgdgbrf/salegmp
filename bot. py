            if not is_bot_itself(user_id_order):
                text = (
                    f"✅ <b>Заявка #{order_id} одобрена!</b>\n\n"
                    f"💎 Куплено: <b>{order['gmp_amount']:.0f} GMP</b>\n"
                    "❤️ Спасибо за покупку!"
                )
                bot.send_message(user_id_order, text, parse_mode="HTML")
        except Exception as e:
            logger.error(f"Не удалось уведомить пользователя {user_id_order}: {e}")
        
        bot.answer_callback_query(call.id, "✅ Заявка подтверждена!")
        # Обновляем сообщение в админ-панели (закрываем просмотр)
        safe_edit_or_send(
            call.message.chat.id,
            call.message.message_id,
            f"✅ <b>Заявка #{order_id} выполнена</b>\n{divider()}\n"
            f"💎 Продано: <b>{order['gmp_amount']:.0f} GMP</b>\n"
            f"👤 Покупатель: {username}",
            parse_mode="HTML",
            reply_markup=back_to_main_keyboard()
        )
        return

    # ========== АДМИН: ОТМЕНА ЗАЯВКИ ==========
    if call.data.startswith("admin_cancel_"):
        order_id = int(call.data.split("_")[2])
        order = db.get_order(order_id)
        if not order:
            bot.answer_callback_query(call.id, "❌ Заявка не найдена")
            return
        db.update_order_status(order_id, "cancelled")
        user = db.get_user(order['user_id'])
        username = f"@{user['username']}" if user and user['username'] else f"ID: {order['user_id']}"
        admin_msg_id = order['admin_message_id'] if order['admin_message_id'] else None
        if admin_msg_id:
            safe_delete_message(Config.ADMIN_ID, admin_msg_id)
        user_msg_id = order['user_message_id'] if order['user_message_id'] else None
        if user_msg_id:
            safe_delete_message(order['user_id'], user_msg_id)
        try:
            if not is_bot_itself(order['user_id']):
                bot.send_message(
                    order['user_id'],
                    f"❌ <b>Заявка #{order_id} отклонена</b>\n\n"
                    "Пожалуйста, проверьте правильность оплаты и попробуйте снова.\n"
                    "При возникновении вопросов обратитесь в поддержку.",
                    parse_mode="HTML"
                )
        except Exception as e:
            logger.error(f"Не удалось уведомить пользователя {order['user_id']}: {e}")
        bot.answer_callback_query(call.id, "❌ Заявка отклонена!")
        safe_edit_or_send(
            call.message.chat.id,
            call.message.message_id,
            f"❌ <b>Заявка #{order_id} отклонена</b>",
            parse_mode="HTML",
            reply_markup=back_to_main_keyboard()
        )
        return

    # ========== АДМИН: ВЫВОД СРЕДСТВ ==========
    if call.data.startswith("admin_withdraw_approve_"):
        request_id = int(call.data.split("_")[3])
        request = db.get_withdraw_request(request_id)
        if request:
            if db.withdraw_bonus(request['user_id'], request['amount']):
                db.update_withdraw_status(request_id, "completed")
                admin_msg_id = request['admin_message_id'] if request['admin_message_id'] else None
                if admin_msg_id:
                    safe_delete_message(Config.ADMIN_ID, admin_msg_id)
                try:
                    if not is_bot_itself(request['user_id']):
                        text = (
                            f"✅ <b>Вывод GMP выполнен!</b>\n\n"
                            f"💰 Сумма: <b>{request['amount']:.2f} GMP</b>\n"
                            "💚 Средства отправлены на указанный аккаунт!"
                        )
                        bot.send_message(request['user_id'], text, parse_mode="HTML")
                except Exception as e:
                    logger.error(f"Не удалось уведомить пользователя {request['user_id']}: {e}")
                bot.answer_callback_query(call.id, "✅ Вывод выполнен!")
                user = db.get_user(request['user_id'])
                username = f"@{user['username']}" if user and user['username'] else f"ID: {request['user_id']}"
                safe_edit_or_send(
                    call.message.chat.id,
                    call.message.message_id,
                    f"✅ <b>Вывод #{request_id} выполнен</b>\n{divider()}\n"
                    f"💰 Сумма: <b>{request['amount']:.2f} GMP</b>\n"
                    f"👤 Пользователь: {username}\n"
                    f"📱 Получатель: {request['recipient']}",
                    parse_mode="HTML"
                )
            else:
                bot.answer_callback_query(call.id, "❌ Недостаточно средств на бонусном балансе!", show_alert=True)
        return

    if call.data.startswith("admin_withdraw_reject_"):
        request_id = int(call.data.split("_")[3])
        request = db.get_withdraw_request(request_id)
        if request:
            db.update_withdraw_status(request_id, "rejected")
            admin_msg_id = request['admin_message_id'] if request['admin_message_id'] else None
            if admin_msg_id:
                safe_delete_message(Config.ADMIN_ID, admin_msg_id)
            try:
                if not is_bot_itself(request['user_id']):
                    bot.send_message(
                        request['user_id'],
                        f"❌ <b>Заявка на вывод #{request_id} отклонена</b>\n\n"
                        "Пожалуйста, проверьте правильность реквизитов и попробуйте снова.\n"
                        "При возникновении вопросов обратитесь в поддержку.",
                        parse_mode="HTML"
                    )
            except Exception as e:
                logger.error(f"Не удалось уведомить пользователя {request['user_id']}: {e}")
            bot.answer_callback_query(call.id, "❌ Вывод отклонен!")
            safe_edit_or_send(
                call.message.chat.id,
                call.message.message_id,
                f"❌ <b>Заявка на вывод #{request_id} отклонена</b>",
                parse_mode="HTML"
            )
        return

    bot.answer_callback_query(call.id)


