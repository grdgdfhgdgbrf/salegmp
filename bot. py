                    username = f"@{user['username']}" if user and user['username'] else f"ID: {user_id}"
                    bot.send_message(Config.ADMIN_ID, f"✅ Crypto Pay заказ #{order_id} подтверждён автоматически.\n👤 {username}\n💎 {order['gmp_amount']:.2f} GMP")
            else:
                bot.answer_callback_query(call.id, "⏳ Оплата ещё не получена. Подождите или проверьте позже.", show_alert=True)
        else:
            bot.answer_callback_query(call.id, "❌ Ошибка: отсутствует ID счёта.", show_alert=True)
        return

    # ========== АДМИН-ПАНЕЛЬ: ОСТАЛЬНЫЕ РАЗДЕЛЫ ==========
    if call.data.startswith("admin_"):
        if not is_admin(user_id):
            bot.answer_callback_query(call.id, "⛔ У вас нет прав!", show_alert=True)
            return

        if call.data == "admin_orders":
            pending_orders = db.get_pending_orders()
            if not pending_orders:
                text = "📋 <b>Новых заявок на пополнение нет</b>\n\nВсе заявки обработаны ✅"
            else:
                text = f"📋 <b>Заявки на пополнение ({len(pending_orders)})</b>\n\n"
                for order in pending_orders[:10]:
                    user_name = order['username'] or order['first_name'] or f"ID: {order['user_id']}"
                    text += f"{divider()}\n#{order['id']} | {user_name}\n💎 {order['gmp_amount']:.2f} GMP\n📅 {format_date(order['created_at'])}\n"
            try:
                bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=admin_orders_keyboard())
            except Exception as e:
                if "message is not modified" not in str(e):
                    logger.error(f"Ошибка admin_orders: {e}")
                bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=admin_orders_keyboard())
            return

        if call.data == "admin_withdraws":
            pending_withdraws = db.get_pending_withdraws()
            if not pending_withdraws:
                text = "💸 <b>Новых заявок на вывод нет</b>\n\nВсе заявки обработаны ✅"
            else:
                text = f"💸 <b>Заявки на вывод ({len(pending_withdraws)})</b>\n\n"
                for req in pending_withdraws[:10]:
                    user_name = req['username'] or req['first_name'] or f"ID: {req['user_id']}"
                    text += f"{divider()}\n#{req['id']} | {user_name}\n💰 {req['amount']:.2f} GMP\n📱 Получатель: {req['recipient']}\n📅 {format_date(req['created_at'])}\n"
            keyboard = types.InlineKeyboardMarkup(row_width=2)
            btn1 = types.InlineKeyboardButton("🔄 Обновить", callback_data="admin_withdraws")
            btn2 = types.InlineKeyboardButton("↩️ Назад", callback_data="back_to_main")
            keyboard.add(btn1, btn2)
            try:
                bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=keyboard)
            except Exception as e:
                if "message is not modified" not in str(e):
                    logger.error(f"Ошибка admin_withdraws: {e}")
                bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=keyboard)
            return

        if call.data == "admin_stats":
            conn = sqlite3.connect(Config.DB_PATH)
            cur = conn.cursor()
            cur.execute('SELECT COUNT(*) FROM users')
            total_users = cur.fetchone()[0]
            cur.execute('SELECT COUNT(*) FROM orders')
            total_orders = cur.fetchone()[0]
            cur.execute('SELECT SUM(gmp_amount) FROM orders WHERE status = "confirmed"')
            total_gmp = cur.fetchone()[0] or 0
            cur.execute('SELECT COUNT(*) FROM orders WHERE status = "pending"')
            pending_count = cur.fetchone()[0]
            cur.execute('SELECT COUNT(*) FROM withdraw_requests WHERE status = "pending"')
            pending_withdraws = cur.fetchone()[0]
            cur.execute('SELECT SUM(amount) FROM withdraw_requests WHERE status = "completed"')
            total_withdrawn = cur.fetchone()[0] or 0
            cur.execute('SELECT SUM(balance) FROM bonus_balance')
            total_bonus = cur.fetchone()[0] or 0
            cur.execute('SELECT COUNT(*) FROM banned_users')
            total_banned = cur.fetchone()[0] or 0
            conn.close()
            price = db.get_setting_float('PRICE_PER_GMP_RUB')
            crypto = db.get_setting_float('CRYPTO_RATE')
            text = (
                "📊 <b>Статистика бота</b>\n\n"
                f"👥 Пользователей: <b>{total_users}</b>\n"
                f"📦 Всего заказов: <b>{total_orders}</b>\n"
                f"⏳ В обработке: <b>{pending_count}</b>\n"
                f"💎 Продано GMP: <b>{total_gmp:.2f}</b>\n"
                f"🎁 Бонусный баланс: <b>{total_bonus:.2f} GMP</b>\n"
                f"💸 Заявок на вывод: <b>{pending_withdraws}</b>\n"
                f"💰 Выведено GMP: <b>{total_withdrawn:.2f}</b>\n"
                f"🚫 Заблокировано: <b>{total_banned}</b>\n"
                f"{divider()}\n"
                f"💰 Цена 1 GMP: <b>{price:.2f} ₽</b>\n"
                f"💲 Курс крипты: 1 USD = <b>{crypto:.2f} GMP</b>"
            )
            try:
                bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=admin_stats_keyboard())
            except Exception as e:
                if "message is not modified" not in str(e):
                    logger.error(f"Ошибка admin_stats: {e}")
                bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=admin_stats_keyboard())
            return

        if call.data == "admin_broadcast":
            bot.send_message(
                chat_id,
                "📢 <b>СОЗДАНИЕ РАССЫЛКИ</b>\n\n"
                "✏️ Введите текст для рассылки\n\n"
                "📌 Текст можно форматировать HTML-тегами.",
                parse_mode="HTML"
            )
            try:
                bot.edit_message_text("⏳ Ожидайте ввода текста...", chat_id, message_id)
            except:
                pass
            bot.register_next_step_handler(call.message, handle_broadcast)
            return

    # ========== АДМИН: ПОДТВЕРЖДЕНИЕ ПОПОЛНЕНИЯ (рубли и старые методы) ==========
    if call.data.startswith("admin_confirm_"):
        order_id = int(call.data.split("_")[2])
        order = db.get_order(order_id)
        if order:
            user = db.get_user(order['user_id'])
            username = f"@{user['username']}" if user and user['username'] else f"ID: {order['user_id']}"
            db.update_order_status(order_id, "confirmed")
            # Начисляем бонусный баланс (если ещё не начислен автоматически)
            # Для рублей начисление происходит здесь, для Crypto Pay – уже автоматически, но дублирование не страшно
            db.update_bonus_balance(order['user_id'], order['gmp_amount'], f"Пополнение {order['type']}: +{order['gmp_amount']} GMP")
            conn = sqlite3.connect(Config.DB_PATH)
            cur = conn.cursor()
            cur.execute('UPDATE users SET orders_count = orders_count + 1 WHERE user_id = ?', (order['user_id'],))
            conn.commit()
            conn.close()
            admin_msg_id = order['admin_message_id'] if order['admin_message_id'] else None
            if admin_msg_id:
                safe_delete_message(Config.ADMIN_ID, admin_msg_id)
            user_msg_id = order['user_message_id'] if order['user_message_id'] else None
            if user_msg_id:
                safe_delete_message(order['user_id'], user_msg_id)
            try:
                if not is_bot_itself(order['user_id']):
                    text = (
                        f"✅ <b>Заявка #{order_id} одобрена!</b>\n\n"
                        f"💎 Начислено: <b>{order['gmp_amount']:.2f} GMP</b>\n"
                        "❤️ Спасибо за покупку!"
                    )
                    bot.send_message(order['user_id'], text, parse_mode="HTML")
            except Exception as e:
                logger.error(f"Не удалось уведомить пользователя {order['user_id']}: {e}")
            bot.answer_callback_query(call.id, "✅ Заявка подтверждена!")
            safe_edit_or_send(
                call.message.chat.id,
                call.message.message_id,
                f"✅ <b>Заявка #{order_id} подтверждена</b>\n{divider()}\n💎 Продано: <b>{order['gmp_amount']:.2f} GMP</b>\n👤 Покупатель: {username}",
                parse_mode="HTML"
            )
        return

    if call.data.startswith("admin_cancel_"):
        order_id = int(call.data.split("_")[2])
        order = db.get_order(order_id)
        if order:
            db.update_order_status(order_id, "cancelled")
            admin_msg_id = order['admin_message_id'] if order['admin_message_id'] else None
            if admin_msg_id:
                safe_delete_message(Config.ADMIN_ID, admin_msg_id)
            user_msg_id = order['user_message_id'] if order['user_message_id'] else None
            if user_msg_id:
                safe_delete_message(order['user_id'], user_msg_id)
            try:
                if not is_bot_itself(order['user_id']):
                    bot.send_message(
                        order['user_id'],
                        f"❌ <b>Заявка #{order_id} отклонена</b>\n\n"
                        "Пожалуйста, проверьте правильность оплаты и попробуйте снова.\n"
                        "При возникновении вопросов обратитесь в поддержку.",
                        parse_mode="HTML"
                    )
            except Exception as e:
                logger.error(f"Не удалось уведомить пользователя {order['user_id']}: {e}")
            bot.answer_callback_query(call.id, "❌ Заявка отклонена!")
            safe_edit_or_send(
                call.message.chat.id,
                call.message.message_id,
                f"❌ <b>Заявка #{order_id} отклонена</b>",
                parse_mode="HTML"
            )
        return

    # ========== АДМИН: ВЫВОД СРЕДСТВ ==========
    if call.data.startswith("admin_withdraw_approve_"):
        request_id = int(call.data.split("_")[3])
        request = db.get_withdraw_request(request_id)
        if request:
            if db.withdraw_bonus(request['user_id'], request['amount']):
                db.update_withdraw_status(request_id, "completed")
                admin_msg_id = request['admin_message_id'] if request['admin_message_id'] else None
                if admin_msg_id:
                    safe_delete_message(Config.ADMIN_ID, admin_msg_id)
                try:
                    if not is_bot_itself(request['user_id']):
                        text = (
                            f"✅ <b>Вывод GMP выполнен!</b>\n\n"
                            f"💰 Сумма: <b>{request['amount']:.2f} GMP</b>\n"
                            "💚 Средства отправлены на указанный аккаунт!"
                        )
                        bot.send_message(request['user_id'], text, parse_mode="HTML")
                except Exception as e:
                    logger.error(f"Не удалось уведомить пользователя {request['user_id']}: {e}")
                bot.answer_callback_query(call.id, "✅ Вывод выполнен!")
                user = db.get_user(request['user_id'])
                username = f"@{user['username']}" if user and user['username'] else f"ID: {request['user_id']}"
                safe_edit_or_send(
                    call.message.chat.id,
                    call.message.message_id,
                    f"✅ <b>Вывод #{request_id} выполнен</b>\n{divider()}\n"
                    f"💰 Сумма: <b>{request['amount']:.2f} GMP</b>\n"
                    f"👤 Пользователь: {username}\n"
                    f"📱 Получатель: {request['recipient']}",
                    parse_mode="HTML"
                )
            else:
                bot.answer_callback_query(call.id, "❌ Недостаточно средств на бонусном балансе!", show_alert=True)
        return

    if call.data.startswith("admin_withdraw_reject_"):
        request_id = int(call.data.split("_")[3])
        request = db.get_withdraw_request(request_id)
        if request:
            db.update_withdraw_status(request_id, "rejected")
            admin_msg_id = request['admin_message_id'] if request['admin_message_id'] else None
            if admin_msg_id:
                safe_delete_message(Config.ADMIN_ID, admin_msg_id)
            try:
                if not is_bot_itself(request['user_id']):
                    bot.send_message(
                        request['user_id'],
                        f"❌ <b>Заявка на вывод #{request_id} отклонена</b>\n\n"
                        "Пожалуйста, проверьте правильность реквизитов и попробуйте снова.\n"
                        "При возникновении вопросов обратитесь в поддержку.",
                        parse_mode="HTML"
                    )
            except Exception as e:
                logger.error(f"Не удалось уведомить пользователя {request['user_id']}: {e}")
            bot.answer_callback_query(call.id, "❌ Вывод отклонен!")
            safe_edit_or_send(
                call.message.chat.id,
                call.message.message_id,
                f"❌ <b>Заявка на вывод #{request_id} отклонена</b>",
                parse_mode="HTML"
            )
        return

    bot.answer_callback_query(call.id)


