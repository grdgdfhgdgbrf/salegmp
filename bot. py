            pass
        bot.register_next_step_handler(call.message, handle_broadcast)
        return

    # ========== АДМИН: ПОДТВЕРЖДЕНИЕ ПОПОЛНЕНИЯ (с учётом склада и рефералов) ==========
    if call.data.startswith("admin_confirm_"):
        order_id = int(call.data.split("_")[2])
        order = db.get_order(order_id)
        if not order:
            bot.answer_callback_query(call.id, "❌ Заявка не найдена")
            return
        # Проверяем наличие GMP на складе
        if Config.TOTAL_GMP_AVAILABLE < order['gmp_amount']:
            bot.answer_callback_query(call.id, f"❌ Недостаточно GMP на складе! Доступно: {Config.TOTAL_GMP_AVAILABLE:.0f}", show_alert=True)
            return
        # Подтверждаем заказ
        user_id_order = order['user_id']
        user = db.get_user(user_id_order)
        username = f"@{user['username']}" if user and user['username'] else f"ID: {user_id_order}"
        
        # Обновляем статус заказа
        db.update_order_status(order_id, "confirmed")
        
        # Увеличиваем счётчик заказов пользователя
        conn = sqlite3.connect(Config.DB_PATH)
        cur = conn.cursor()
        cur.execute('UPDATE users SET orders_count = orders_count + 1 WHERE user_id = ?', (user_id_order,))
        conn.commit()
        conn.close()
        
        # Списываем GMP со склада
        new_available = Config.TOTAL_GMP_AVAILABLE - order['gmp_amount']
        db.set_setting('TOTAL_GMP_AVAILABLE', new_available)
        sync_config_from_db()  # обновляем Config
        
        # Начисляем реферальный бонус, если есть реферер
        if user and user['referrer_id']:
            referrer_id = user['referrer_id']
            referral_percent = Config.REFERRAL_PERCENT
            bonus = order['gmp_amount'] * (referral_percent / 100)
            if bonus > 0:
                db.update_bonus_balance(referrer_id, bonus, f"Реферал: +{bonus:.2f} GMP за покупку реферала")
                db.add_referral_earnings(referrer_id, bonus)
