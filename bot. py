def show_main_menu(chat_id, message_id=None):
    user_id = chat_id
    
    if db.is_user_banned(user_id):
        if message_id:
            try:
                bot.edit_message_text("🚫 Вы заблокированы в боте!", chat_id, message_id)
            except:
                bot.send_message(chat_id, "🚫 Вы заблокированы в боте!")
        else:
            bot.send_message(chat_id, "🚫 Вы заблокированы в боте!")
        return
    
    db.update_user_activity(user_id)
    
    if not check_subscription(user_id):
        markup = types.InlineKeyboardMarkup(row_width=1)
        btn1 = types.InlineKeyboardButton("🔗 Подписаться на канал", url=Config.CHANNEL_LINK)
        btn2 = types.InlineKeyboardButton("✅ Проверить подписку", callback_data="check_sub")
        markup.add(btn1, btn2)
        
        text = (
            "🔒 <b>Для продолжения подпишись на канал</b>\n\n"
            "Подпишитесь и нажмите кнопку проверки! ✅"
        )
        
        if message_id:
            try:
                bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=markup)
            except Exception as e:
                logger.error(f"Ошибка редактирования сообщения подписки: {e}")
                bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=markup)
        else:
            bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=markup)
        return
    
    user = db.get_user(user_id)
    if not user or not user['registered']:
        try:
            chat = bot.get_chat(user_id)
            username = chat.username
            first_name = chat.first_name or "Пользователь"
            last_name = chat.last_name
        except:
            username = None
            first_name = "Пользователь"
            last_name = None
        
        db.register_user(user_id, username, first_name, last_name)
        user = db.get_user(user_id)
    
    first_name = user['first_name'] if user and user['first_name'] else "Пользователь"
    
    text = (
        f"🫪 <b>Асалам маллекум, {first_name}!</b>\n\n"
        "💰 <b>Граф GMP — твой надёжный поставщик GMP!</b>\n\n"
        "⚡️ <b>Что я могу:</b>\n"
        " • Продажа GMP по выгодному курсу\n"
        " • Пополнение через звёзды Telegram\n"
        " • Пополнение банковской картой\n\n"
        "✨ <b>Выбери действие ниже:</b>"
    )
    
    if is_admin(user_id):
        markup = admin_panel_keyboard()
    else:
        markup = main_menu_keyboard()
    
    if message_id:
        try:
            bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=markup)
        except Exception as e:
            logger.error(f"Ошибка редактирования главного меню: {e}")
            bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=markup)
    else:
        bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=markup)

# ========== ОБРАБОТЧИКИ КОМАНД ==========
@bot.message_handler(commands=['start'])
def start_command(message):
    user_id = message.from_user.id
    
    if db.is_user_banned(user_id):
        bot.send_message(message.chat.id, "🚫 Вы заблокированы в боте!")
        return
    
    if len(message.text.split()) > 1:
        referral_code = message.text.split()[1]
        referrer_id = db.get_user_by_referral_code(referral_code)
        if referrer_id and referrer_id != user_id:
            user = db.get_user(user_id)
            if not user or not user['registered']:
                try:
                    chat = bot.get_chat(user_id)
                    username = chat.username
                    first_name = chat.first_name or "Пользователь"
                    last_name = chat.last_name
                except:
                    username = None
                    first_name = "Пользователь"
                    last_name = None
                
                db.register_user(user_id, username, first_name, last_name, referrer_id)
                db.add_referral(referrer_id, user_id)
                
                try:
                    bot.send_message(
                        referrer_id,
                        f"Пользователь @{username or first_name} перешел по вашей ссылке!\n"
                    )
                except:
                    pass
                
                bot.send_message(
                    message.chat.id,
                    "✅ Вы зарегистрированы по реферальной ссылке!\n"
                    "Теперь вы можете пользоваться ботом.",
                    parse_mode="HTML"
                )
                show_main_menu(message.chat.id)
                return
    
    show_main_menu(message.chat.id)
    
    # Устанавливаем команды бота
    try:
        bot.set_my_commands([
            BotCommand("start", "💸 Купить GMP")
        ])
    except Exception as e:
        logger.error(f"Ошибка установки команд: {e}")

# ========== КОЛБЭКИ ==========
@bot.callback_query_handler(func=lambda call: True)
def callback_handler(call):
    user_id = call.from_user.id
    message_id = call.message.message_id
    chat_id = call.message.chat.id
    
    if is_bot_itself(user_id):
        bot.answer_callback_query(call.id)
        return
    
    if db.is_user_banned(user_id):
        bot.answer_callback_query(call.id, "🚫 Вы заблокированы!", show_alert=True)
        return
    
    db.update_user_activity(user_id)
    
    # ====== ПРОВЕРКА ПОДПИСКИ ======
    if call.data == "check_sub":
        if check_subscription(user_id):
            show_main_menu(chat_id, message_id)
        else:
            bot.answer_callback_query(call.id, "❌ Вы не подписаны на канал!", show_alert=True)
        return
    
    # ====== ГЛАВНАЯ НАВИГАЦИЯ ======
    if call.data == "back_to_main":
        show_main_menu(chat_id, message_id)
        return
    
    if call.data == "back_to_payment":
        text = "💳 <b>Выберите способ оплаты:</b>"
        try:
            bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=payment_methods_keyboard())
        except Exception as e:
            logger.error(f"Ошибка back_to_payment: {e}")
            bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=payment_methods_keyboard())
        return
    
    if call.data == "back_to_stars_type":
        text = "⭐️ <b>Выберите тип пополнения звёздами:</b>"
        try:
            bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=stars_type_keyboard())
        except Exception as e:
            logger.error(f"Ошибка back_to_stars_type: {e}")
            bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=stars_type_keyboard())
        return
    
    if call.data == "back_to_balance":
        show_balance(chat_id, message_id, user_id)
        return
    
    # ====== КАНАЛ ======
    if call.data == "channel":
        text = (
            "📢 <b>Наш канал</b>\n\n"
            "Подписывайся, чтобы не пропустить:\n"
            "▫️ Актуальные курсы GMP\n"
            "▫️ Новые акции\n"
            "▫️ Раздачи 24/7\n\n"
            "🔽 Переходи по ссылке ниже!"
        )
        try:
            bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=channel_keyboard())
        except Exception as e:
            logger.error(f"Ошибка channel: {e}")
            bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=channel_keyboard())
        return
    
    # ====== ПОДДЕРЖКА ======
    if call.data == "support":
        text = (
            "🆘 <b>Служба поддержки</b>\n\n"
            "Если у вас возникли вопросы или проблемы:\n"
            "▫️ Напишите нам в личные сообщения\n"
