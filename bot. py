def handle_crypto_pay_amount(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id):
        return
    try:
        amount = float(message.text.replace(',', '.'))
        min_crypto = db.get_setting_float('MIN_CRYPTO_AMOUNT')
        max_crypto = db.get_setting_float('MAX_CRYPTO_AMOUNT')
        if amount < min_crypto:
            bot.send_message(
                chat_id,
                f"❌ Минимальная сумма: <b>{min_crypto:.2f} USD</b>\n\n✏️ Введите корректную сумму",
                parse_mode="HTML",
                reply_markup=crypto_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_crypto_pay_amount)
            return
        if amount > max_crypto:
            bot.send_message(
                chat_id,
                f"❌ Максимальная сумма: <b>{max_crypto:.2f} USD</b>\n\n✏️ Введите корректную сумму",
                parse_mode="HTML",
                reply_markup=crypto_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_crypto_pay_amount)
            return
        rate = db.get_setting_float('CRYPTO_RATE')
        gmp = amount * rate
        order_id = db.create_order(user_id, "crypto_pay", amount, gmp)

        # Создаём счёт в Crypto Pay
        invoice = crypto_pay.create_invoice(amount, currency='USD', description=f'Пополнение GMP для пользователя {user_id}')
        if invoice is None:
            bot.send_message(chat_id, "❌ Ошибка при создании счёта. Попробуйте позже.", parse_mode="HTML")
