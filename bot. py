# ----- ВЫВОД GMP -----
def handle_withdraw_amount(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id):
        return
    try:
        amount = float(message.text.replace(',', '.'))
        min_withdraw = db.get_setting_float('MIN_WITHDRAW_GMP')
        if amount < min_withdraw:
            bot.send_message(
                chat_id,
                f"❌ Минимальная сумма для вывода: <b>{min_withdraw:.2f} GMP</b>\n\n✏️ Введите корректную сумму",
                parse_mode="HTML",
                reply_markup=withdraw_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_withdraw_amount)
            return
        bonus_balance = db.get_bonus_balance(user_id)
        if amount > bonus_balance:
            bot.send_message(
                chat_id,
                f"❌ Недостаточно средств!\n\n🎁 Ваш бонусный баланс: <b>{bonus_balance:.2f} GMP</b>\n✏️ Введите сумму меньше или равную балансу",
                parse_mode="HTML",
                reply_markup=withdraw_back_keyboard()
            )
            bot.register_next_step_handler(message, handle_withdraw_amount)
            return
        bot.send_message(
            chat_id,
            f"💰 Сумма: <b>{amount:.2f} GMP</b>\n\n📱 <b>Введите ID или @username получателя:</b>\n"
            "(Telegram ID или юзернейм, куда отправить GMP)",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_recipient, amount)
    except ValueError:
        bot.send_message(
            chat_id,
            "❌ Введите <b>число</b> (можно дробное)\n\n✏️ Например: 50.5",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_amount)

def handle_withdraw_recipient(message, amount):
    user_id = message.from_user.id
    chat_id = message.chat.id
    if is_bot_itself(user_id):
        return
    recipient = message.text.strip()
    if len(recipient) < 2:
        bot.send_message(
            chat_id,
            "❌ Некорректный получатель!\n\n📱 Введите ID или @username получателя",
            parse_mode="HTML",
            reply_markup=withdraw_back_keyboard()
        )
        bot.register_next_step_handler(message, handle_withdraw_recipient, amount)
        return
    request_id = db.create_withdraw_request(user_id, amount, recipient)
    user = db.get_user(user_id)
    username = f"@{user['username']}" if user and user['username'] else f"ID: {user_id}"
    if Config.ADMIN_ID:
        try:
            caption = (
                f"💸 <b>Заявка на вывод GMP</b>\n{divider()}\n"
                f"👤 От: {username}\n"
                f"💰 Сумма: <b>{amount:.2f} GMP</b>\n"
                f"📱 Получатель: <b>{recipient}</b>\n"
                f"📅 {datetime.now().strftime('%d.%m.%Y %H:%M')}\n{divider()}\n"
                f"<code>перевод {amount:.2f} GMP на {recipient}</code>"
            )
            admin_msg = bot.send_message(
                Config.ADMIN_ID,
                caption,
                parse_mode="HTML",
                reply_markup=admin_withdraw_keyboard(request_id)
            )
            db.update_withdraw_status(request_id, "pending", admin_msg_id=admin_msg.message_id)
        except Exception as e:
            logger.error(f"Ошибка отправки админу: {e}")
    bot.send_message(
        chat_id,
        f"✅ <b>Заявка на вывод принята!</b>\n\n⏳ Ожидайте обработки администратором.\n"
        "Обычно это занимает до 24 часов.\n\n📌 Если у вас возникли вопросы, обратитесь в поддержку.",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

