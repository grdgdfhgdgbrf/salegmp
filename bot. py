        cur.execute('SELECT COUNT(*) FROM orders')
        total_orders = cur.fetchone()[0]
        cur.execute('SELECT SUM(gmp_amount) FROM orders WHERE status = "confirmed"')
        total_gmp = cur.fetchone()[0] or 0
        cur.execute('SELECT COUNT(*) FROM orders WHERE status = "pending"')
        pending_count = cur.fetchone()[0]
        cur.execute('SELECT COUNT(*) FROM withdraw_requests WHERE status = "pending"')
        pending_withdraws = cur.fetchone()[0]
        cur.execute('SELECT SUM(amount) FROM withdraw_requests WHERE status = "completed"')
        total_withdrawn = cur.fetchone()[0] or 0
        cur.execute('SELECT SUM(balance) FROM bonus_balance')
        total_bonus = cur.fetchone()[0] or 0
        cur.execute('SELECT COUNT(*) FROM banned_users')
        total_banned = cur.fetchone()[0] or 0
        conn.close()
        price = Config.PRICE_PER_GMP_RUB
        available = Config.TOTAL_GMP_AVAILABLE
        text = (
            "📊 <b>Статистика бота</b>\n\n"
            f"👥 Пользователей: <b>{total_users}</b>\n"
