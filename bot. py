# ====== РАССЫЛКА ======
def handle_broadcast(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    
    if is_bot_itself(user_id):
        return
    
    if not is_admin(user_id):
        return
    
    text = message.text
    
    conn = sqlite3.connect(Config.DB_PATH)
    cur = conn.cursor()
    cur.execute('SELECT user_id FROM users')
    users = cur.fetchall()
    conn.close()
    
    sent = 0
    failed = 0
    
    status_msg = bot.send_message(chat_id, "📢 <b>Начинаю рассылку...</b>", parse_mode="HTML")
    
    for user in users:
        try:
            if not is_bot_itself(user[0]):
                bot.send_message(user[0], text, parse_mode="HTML")
                sent += 1
                if sent % 10 == 0:
                    try:
                        bot.edit_message_text(
                            f"📢 <b>Рассылка в процессе...</b>\n\n"
                            f"✅ Отправлено: <b>{sent}</b>\n"
                            f"❌ Ошибок: <b>{failed}</b>",
                            chat_id,
                            status_msg.message_id,
                            parse_mode="HTML"
                        )
                    except:
                        pass
        except Exception as e:
            failed += 1
            logger.error(f"Ошибка рассылки {user[0]}: {e}")
    
    bot.edit_message_text(
        f"📢 <b>Рассылка завершена!</b>\n\n"
        f"✅ Отправлено: <b>{sent}</b>\n"
        f"❌ Ошибок: <b>{failed}</b>",
        chat_id,
        status_msg.message_id,
        parse_mode="HTML"
    )

