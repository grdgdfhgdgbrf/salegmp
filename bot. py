        logger.info("База данных инициализирована")
    
    def migrate_db(self):
        """Добавляем новые колонки если их нет"""
        conn = sqlite3.connect(self.db_path)
        cur = conn.cursor()
        
        # Проверяем колонки в users
        cur.execute("PRAGMA table_info(users)")
        columns = [col[1] for col in cur.fetchall()]
        
        if 'total_withdrawn' not in columns:
            cur.execute("ALTER TABLE users ADD COLUMN total_withdrawn REAL DEFAULT 0")
            logger.info("Добавлена колонка total_withdrawn в users")
        
        if 'referral_earnings' not in columns:
            cur.execute("ALTER TABLE users ADD COLUMN referral_earnings REAL DEFAULT 0")
            logger.info("Добавлена колонка referral_earnings в users")
        
        if 'last_case_open' not in columns:
            cur.execute("ALTER TABLE users ADD COLUMN last_case_open TIMESTAMP DEFAULT NULL")
            logger.info("Добавлена колонка last_case_open в users")
        
        # Проверяем колонки в banned_users
        cur.execute("PRAGMA table_info(banned_users)")
        columns = [col[1] for col in cur.fetchall()]
        
        if 'banned_by' not in columns:
            cur.execute("ALTER TABLE banned_users ADD COLUMN banned_by INTEGER DEFAULT NULL")
            logger.info("Добавлена колонка banned_by в banned_users")
        
        conn.commit()
        conn.close()
    
