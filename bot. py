# ========== CRYPTO PAY API ==========
class CryptoPay:
    def __init__(self, token):
        self.token = token
        self.base_url = Config.CRYPTO_PAY_API_URL

    def _request(self, method, params=None):
        url = f"{self.base_url}/{method}"
        headers = {
            'Crypto-Pay-API-Token': self.token,
            'Content-Type': 'application/json'
        }
        try:
            response = requests.post(url, json=params or {}, headers=headers, timeout=30)
            if response.status_code == 200:
                data = response.json()
                if data.get('ok'):
                    return data.get('result')
                else:
                    logger.error(f"Crypto Pay API error: {data}")
                    return None
            else:
                logger.error(f"Crypto Pay API HTTP error: {response.status_code} - {response.text}")
                return None
        except Exception as e:
            logger.error(f"Crypto Pay API request failed: {e}")
            return None

    def create_invoice(self, amount, currency='USD', description='Пополнение GMP'):
        """
        Создаёт счёт на оплату.
        currency: 'USD', 'EUR', 'RUB' или криптовалюта (по умолчанию USD)
        Возвращает объект инвойса с полями: invoice_id, pay_url, status и т.д.
        """
        params = {
            'amount': amount,
            'currency_type': 'fiat',
            'currency': currency,
            'description': description,
            'payload': {'source': 'gmp_bot'}
        }
        result = self._request('createInvoice', params)
        if result:
            return result
        return None

    def check_invoice_status(self, invoice_id):
        """Проверяет статус инвойса по его ID."""
        params = {'invoice_id': invoice_id}
        result = self._request('getInvoices', params)
        if result and 'items' in result and len(result['items']) > 0:
            return result['items'][0]
        return None

    def is_paid(self, invoice_id):
        """Возвращает True, если счёт оплачен."""
        invoice = self.check_invoice_status(invoice_id)
        if invoice:
            status = invoice.get('status')
            return status == 'paid'
        return False


