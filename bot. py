def show_balance(chat_id, message_id=None, user_id=None):
    if user_id is None:
        user_id = chat_id
    
    user = db.get_user(user_id)
    if not user:
        show_main_menu(chat_id, message_id)
        return
    
    bonus_balance = db.get_bonus_balance(user_id)
    referrals = db.get_referrals_count(user_id)
    min_withdraw = db.get_setting_float('MIN_WITHDRAW_GMP')
    min_refs = db.get_setting_int('MIN_REFERRALS_FOR_WITHDRAW')
    
    text = (
        f"🎁 <b>Баланс GMP: {int(bonus_balance)} GMP</b>\n\n"
    )
    
    if referrals >= min_refs and bonus_balance >= min_withdraw:
        text += "✅ <b>Условия выполнены! Можете выводить</b>"
    else:
        if referrals < min_refs:
            text += f"❌ Нужно пригласить еще <b>{min_refs - referrals}</b> друзей\n"
        if bonus_balance < min_withdraw:
            text += f"❌ Нужно накопить еще <b>{min_withdraw - int(bonus_balance)} GMP</b>"
    
    try:
        if message_id:
            bot.edit_message_text(text, chat_id, message_id, parse_mode="HTML", reply_markup=balance_keyboard())
        else:
            bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=balance_keyboard())
    except Exception as e:
        logger.error(f"Ошибка balance: {e}")
        bot.send_message(chat_id, text, parse_mode="HTML", reply_markup=balance_keyboard())

