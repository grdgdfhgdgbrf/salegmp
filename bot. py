def handle_ban_user(message):
    user_id = message.from_user.id
    chat_id = message.chat.id
    admin_id = user_id
    
    if not is_admin(admin_id):
        return
    
    target = message.text.strip()
    
    try:
        if target.startswith('@'):
            target_user = bot.get_chat(target)
            target_id = target_user.id
        else:
            target_id = int(target)
    except:
        bot.send_message(
            chat_id,
            "❌ Пользователь не найден!\n"
            "Проверьте ID или @username и попробуйте снова.",
            parse_mode="HTML"
        )
        return
    
    if target_id == admin_id:
        bot.send_message(chat_id, "❌ Нельзя забанить самого себя!", parse_mode="HTML")
        return
    
    if is_admin(target_id):
        bot.send_message(chat_id, "❌ Нельзя забанить администратора!", parse_mode="HTML")
        return
    
    msg = bot.send_message(
        chat_id,
        f"🚫 <b>Бан пользователя</b>\n\n"
        f"👤 ID: <code>{target_id}</code>\n\n"
        f"✏️ Введите причину бана:\n"
        "(или отправьте 'пропустить' для стандартной причины)",
        parse_mode="HTML"
    )
    bot.register_next_step_handler(msg, handle_ban_reason, target_id)

def handle_ban_reason(message, target_id):
    user_id = message.from_user.id
    chat_id = message.chat.id
    
    if not is_admin(user_id):
        return
    
    reason = message.text.strip()
    if reason.lower() == 'пропустить':
        reason = "Нарушение правил"
    
    db.ban_user(target_id, reason, user_id)
    
    try:
        bot.send_message(
            target_id,
            f"🚫 <b>Вы заблокированы в боте!</b>\n\n"
            f"📌 Причина: {reason}\n\n"
            "Если вы считаете, что это ошибка, обратитесь к администратору.",
            parse_mode="HTML"
        )
    except:
        pass
    
    bot.send_message(
        chat_id,
        f"✅ <b>Пользователь забанен!</b>\n\n"
        f"👤 ID: <code>{target_id}</code>\n"
        f"📌 Причина: {reason}",
        parse_mode="HTML",
        reply_markup=back_to_main_keyboard()
    )

